// The Worker mise run prove-actions has GitHub Actions deploy (cloudflare.toml's [workflow] deploy): production from a
// throwaway branch, a preview pr-<number> per pull request. Nothing else ever deploys it, so its answering proves
// GitHub Actions did.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-zero-actions",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  // A KV namespace, so its previews prove go tool cloudflare previews in GitHub Actions: they get their own, from the
  // Worker's Previews Base, which the block leaves KV out for.
  "kv_namespaces": [{ "binding": "KV" }],
  "previews": {}
}
