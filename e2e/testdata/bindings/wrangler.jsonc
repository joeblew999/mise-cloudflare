// The Worker mise run prove-bindings deploys: one of each kind of binding Cloudflare can make for nothing, on a login
// with wrangler's own login's scopes. Its queue, Vectorize index and Workflow are its own: the proof makes them and
// deletes them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-zero-bindings",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "queues": { "producers": [{ "binding": "Q", "queue": "cloudflare-zero-bindings-q" }] },
  "vectorize": [{ "binding": "V", "index_name": "cloudflare-zero-bindings-idx" }],
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "DO", "class_name": "Counter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }],
  "workflows": [{ "name": "cloudflare-zero-bindings-wf", "binding": "WF", "class_name": "Flow" }],
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "cloudflare_zero_bindings" }],
  "ratelimits": [{ "name": "RL", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } }],
  "browser": { "binding": "BROWSER" },
  "images": { "binding": "IMAGES" }
}
