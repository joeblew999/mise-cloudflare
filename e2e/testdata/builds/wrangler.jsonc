// The Worker mise run prove-builds has Cloudflare's Workers Builds deploy from GitHub, as production, as staging (env.staging,
// its own Worker and its own KV and R2) and as previews. It uses a KV namespace and an R2 bucket, which Cloudflare's own
// build token may create and use, and says which branch Workers Builds built it from (BUILT_BY, set by
// cloudflare.toml's [builds] commands), "here" when deployed by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-zero-builds",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "BUCKET" }],
  "env": {
    "staging": {
      "kv_namespaces": [{ "binding": "KV" }],
      "r2_buckets": [{ "binding": "BUCKET" }]
    }
  }
}
