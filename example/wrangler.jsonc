// No account ID and no resource IDs: the first deploy creates D1, KV and R2, named after the Worker, and later deploys find them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-zero-example",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{ "binding": "DB" }],
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "BUCKET" }],
  "secrets": { "required": ["GREETING"] },
  // Worker Previews (wrangler preview, Workers Builds' and GitHub Actions' previews) inherit nothing from production:
  // their bindings are declared here, and wrangler creates their own D1, KV and R2 for them.
  "previews": {
    "d1_databases": [{ "binding": "DB" }],
    "kv_namespaces": [{ "binding": "KV" }],
    "r2_buckets": [{ "binding": "BUCKET" }]
  }
}
