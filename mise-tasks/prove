#!/usr/bin/env bash
#MISE description="Prove per-repo Cloudflare logins work, end to end, in example/ (its own profile, cloudflare-zero-example): a local test with no login at all; deploy on the repo's own login (the browser opens once, the first time only); a live test of D1, KV, R2 and the secret; a second deploy that asks nothing and keeps the same resources; the repo left unchanged; stray tokens refused; teardown leaves nothing; the machine's default login untouched throughout. --clean also removes the login and proves it's gone"
#MISE timeout="20m"
#USAGE flag "--clean" help="Also remove example/'s login (cloudflare:clean) and prove it's gone; the next run then opens the browser again"
set -euo pipefail
. "$(dirname "$0")/../shared/cloudflare/.helpers.sh"
cd "$(dirname "$0")/../example"
trap 'rm -f .env' EXIT
step() { printf '\n=== %s\n' "$*"; }
pass() { echo "PASS $*"; }
fail() { echo "FAIL $*"; exit 1; }
CF_PROFILE=$(mise env --json | jq -r .CF_PROFILE)
home=$(wrangler_home)
default_login=$(file_hash "$home/config/default.toml")
echo "machine's default login: config/default.toml $default_login (checksum; the contents are never read)"

step "1. A developer with no Cloudflare login at all: setup and local test"
XDG_CONFIG_HOME=$(mktemp -d) mise run cloudflare:test
pass "local dev works with no Cloudflare login"

step "2. Deploy on the repo's own login, $CF_PROFILE (logs in once if it isn't logged in yet)"
# Every machine proving this repo on the same account deploys the same Worker, and one's teardown would delete the
# other's. So start only if it isn't deployed already. mise exec gives example/'s own settings (CF_SCOPES and the rest).
mise exec -- bash -c 'set -e; . ../shared/cloudflare/.helpers.sh; ensure_login; worker_exists' && rc=0 || rc=$?
case $rc in
  3) pass "the Worker isn't deployed on this account yet, so nothing else is using it" ;;
  0) fail "the Worker is already deployed on this account: another machine may be proving it now. Wait for it, or run cloudflare:teardown here if it's left over" ;;
  *) fail "couldn't check whether the Worker is deployed" ;;
esac
repo_before=$(git status --porcelain .)
GREETING=set-by-prove mise run cloudflare:deploy
[ -f "$(profile_file)" ] && pass "profile $CF_PROFILE exists" || fail "no profile $CF_PROFILE"
jq -e --arg d "$PWD" --arg p "$CF_PROFILE" '.[$d] == $p' "$home/profiles/directory-bindings.json" > /dev/null \
  && pass "profile $CF_PROFILE is bound to ${PWD/#$HOME/~}" || fail "profile not bound to $PWD"
[ "$(file_hash "$home/config/default.toml")" = "$default_login" ] && pass "default login untouched" || fail "default login changed"

step "3. The live Worker: D1, KV, R2 and the secret"
mise run cloudflare:test --prod
resources_first=$(mise run cloudflare:status 2>/dev/null | grep '^resource')
echo "$resources_first"

step "4. Deploy again: no login, no secret asked, the same resources, the repo unchanged"
out=$(mise run cloudflare:deploy </dev/null 2>&1) || { echo "$out"; fail "second deploy failed"; }
grep -E 'Logging in|also needs|Value for the secret|secret .*: will be set' <<<"$out" && fail "the second deploy asked for something" || pass "asked nothing"
[ "$(mise run cloudflare:status 2>/dev/null | grep '^resource')" = "$resources_first" ] && pass "same D1, KV and R2" || fail "resources changed"
[ "$(git status --porcelain .)" = "$repo_before" ] && pass "deploying changed nothing in the repo (no IDs written)" || { git status --porcelain .; fail "the repo changed"; }

step "5. A stray CLOUDFLARE_API_TOKEN is refused, in the shell and in a .env"
if out=$(CLOUDFLARE_API_TOKEN=dummy-not-a-real-token mise run cloudflare:deploy 2>&1); then fail "deployed with a token in the shell"; fi
grep 'refusing:' <<<"$out" && pass "token in the shell refused" || { echo "$out"; fail "not refused for the right reason"; }
echo 'CLOUDFLARE_API_TOKEN=dummy-not-a-real-token' > .env
if out=$(mise run cloudflare:deploy 2>&1); then fail "deployed with a token in .env"; fi
grep 'refusing:' <<<"$out" && pass "token in .env refused" || { echo "$out"; fail "not refused for the right reason"; }
rm -f .env

step "6. Teardown leaves nothing on Cloudflare"
url=$(deployed_url)
mise run cloudflare:teardown
left=$(mise run cloudflare:status 2>/dev/null | grep '^resource' | grep -v ' none$' || true)
[ -z "$left" ] && pass "no D1, KV or R2 left" || { echo "$left"; fail "resources left"; }
code=$(curl -s -o /dev/null -w '%{http_code}' -m 15 "$url" || true)
[ "$code" != 200 ] && pass "$url no longer answers (HTTP $code)" || fail "$url still answers"

if [ "${usage_clean:-false}" = true ]; then
  step "7. Clean removes the login and its folder binding"
  mise run cloudflare:clean
  [ ! -f "$(profile_file)" ] && pass "profile $CF_PROFILE gone" || fail "profile still there"
  jq -e --arg d "$PWD" 'has($d) | not' "$home/profiles/directory-bindings.json" > /dev/null 2>&1 || [ ! -f "$home/profiles/directory-bindings.json" ] \
    && pass "folder binding gone" || fail "folder binding still there"
fi

[ "$(file_hash "$home/config/default.toml")" = "$default_login" ] && pass "the machine's default login was untouched throughout" || fail "default login changed"
echo; echo "ALL PASSED"
