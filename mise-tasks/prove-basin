#!/usr/bin/env bash
#MISE description="Prove Basin works on a repo's own login, no API token: in example/ (profile cloudflare-zero-example, CF_SCOPES with pipelines:write) make an R2 bucket, turn on Basin Catalog, create a Basin Pipeline (stream, catalog sink whose token is the login's own, SQL), send events with the login's token, read them back with Basin SQL (https://api.sql.cloudflarestorage.com), then remove it all"
#MISE timeout="20m"
set -euo pipefail
if [ -z "${PROVE_BASIN_INNER:-}" ]; then cd "$(dirname "$0")/../example"; PROVE_BASIN_INNER=1 exec mise exec -- bash "$0"; fi
. "$(dirname "$0")/../shared/cloudflare/.helpers.sh"
step() { printf '\n=== %s\n' "$*"; }
pass() { echo "PASS $*"; }
fail() { echo "FAIL $*"; exit 1; }
B=cloudflare-zero-basin; S=cf_zero_stream; K=cf_zero_sink; P=cf_zero_pipeline; NS=default; T=events
token() { wrangler auth token --json </dev/null | jq -r .token; }
cleanup() {
  set +e
  step "Removing everything"
  wrangler basin pipelines delete $P -y </dev/null > /dev/null 2>&1 && echo "deleted pipeline $P"
  wrangler basin pipelines sinks delete $K -y </dev/null > /dev/null 2>&1 && echo "deleted sink $K"
  wrangler basin pipelines streams delete $S -y </dev/null > /dev/null 2>&1 && echo "deleted stream $S"
  wrangler basin catalog disable $B </dev/null > /dev/null 2>&1 && echo "turned off Basin Catalog on $B"
  empty_r2_bucket $B && wrangler r2 bucket delete $B </dev/null > /dev/null 2>&1 && echo "deleted R2 $B"
  wrangler r2 bucket list </dev/null 2>/dev/null | grep -q "^name: *$B$" && echo "FAIL R2 $B is still there" || echo "PASS nothing left"
}

step "The repo's own login, with its scopes: $CF_SCOPES"
ensure_login
[ "$(wrangler auth token --json </dev/null | jq -r .type)" = oauth ] && pass "authenticated by the login (OAuth), no API token" || fail "not an OAuth login"
acct=$(wrangler whoami --json </dev/null | jq -r '.accounts[0].id')
trap cleanup EXIT

step "R2 bucket and Basin Catalog"
wrangler r2 bucket create $B </dev/null 2>&1 | grep -E 'Created|already' || true
wrangler basin catalog enable $B </dev/null 2>&1 | grep -E 'Warehouse|enabled|Error' || true

step "Basin Pipeline: stream, catalog sink (its catalog token is the login's own), SQL"
schema=$(mktemp)
echo '{"fields":[{"name":"path","type":"string","required":true},{"name":"n","type":"int64","required":true}]}' > "$schema"
out=$(wrangler basin pipelines streams create $S --schema-file "$schema" </dev/null 2>&1) || { echo "$out"; fail "stream not created"; }
ingest=$(grep -oE 'https://[a-z0-9]+\.ingest\.cloudflare\.com' <<<"$out" | head -1)
[ -n "$ingest" ] && pass "stream $S, endpoint $ingest" || { echo "$out"; fail "no ingest endpoint"; }
out=$(wrangler basin pipelines sinks create $K --type r2-data-catalog --bucket $B --namespace $NS --table $T \
  --catalog-token "$(token)" --roll-interval 60 </dev/null 2>&1) && pass "sink $K into $NS.$T" || { echo "$out"; fail "sink not created"; }
out=$(wrangler basin pipelines create $P --sql "INSERT INTO $K SELECT * FROM $S" </dev/null 2>&1) && pass "pipeline $P" || { echo "$out"; fail "pipeline not created"; }

step "Send 3 events, authenticated with the login's own token"
curl -fsS -m 30 -X POST "$ingest" -H "Authorization: Bearer $(token)" -H 'Content-Type: application/json' \
  -d '[{"path":"/a","n":1},{"path":"/b","n":2},{"path":"/a","n":3}]' && echo && pass "events accepted"

step "Read them back with Basin SQL, with the login's own token (the first files take a few minutes)"
for i in $(seq 1 40); do
  res=$(curl -sS -m 30 -X POST "https://api.sql.cloudflarestorage.com/api/v1/accounts/$acct/basin-sql/query/$B" \
    -H "Authorization: Bearer $(token)" -H 'Content-Type: application/json' -d "{\"query\":\"SELECT path, n FROM $NS.$T ORDER BY n\"}")
  rows=$(jq -c '.result.rows // empty' <<<"$res" 2>/dev/null || true)
  if [ -n "$rows" ] && [ "$(jq length <<<"$rows")" -ge 3 ]; then echo "$rows"; pass "Basin SQL returned the 3 events"; break; fi
  state=$(wrangler basin pipelines list </dev/null 2>&1 | grep -A1 " $P " || true)
  if grep -q failed <<<"$state"; then echo "$state"; fail "Cloudflare marked the pipeline failed"; fi
  echo "waiting ($i): $(jq -c '.errors // .result.rows' <<<"$res" 2>/dev/null | head -c 160)"
  [ "$i" = 40 ] && fail "no rows after 10 minutes"
  sleep 15
done
WRANGLER_BASIN_SQL_AUTH_TOKEN=$(token) wrangler basin sql query "${acct}_$B" "SELECT path, count(*) AS hits FROM $NS.$T GROUP BY path ORDER BY path" </dev/null 2>&1 | grep -vE '⛅️|^─+$|update available|^\s*$'
echo "the login's token expires $(grep -E '^expiration_time' "$(profile_file)" | cut -d'"' -f2); wrangler refreshes it on this machine"
echo; echo "ALL PASSED"
