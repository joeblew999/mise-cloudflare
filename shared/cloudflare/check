#!/usr/bin/env bash
#MISE description="Check this repo follows the Cloudflare rules: no account or resource IDs and no tokens in its files, .dev.vars and .env git-ignored, .dev.vars.example matches secrets.required, wrangler pinned to an exact version, nothing calls the machine-wide wrangler login. No Cloudflare account needed"
#MISE depends=["cloudflare:setup"]
#MISE timeout="2m"
set -euo pipefail
. "$(dirname "$0")/.helpers.sh"
fail=0
bad() { echo "FAIL $*"; fail=1; }
# The repo's own files. These shared tasks are left out when they sit inside the repo (as in cloudflare-zero itself),
# because their helpers call `wrangler login` on purpose, into a temporary folder, in a Claude Code cloud session.
self=$(cd "$(dirname "$0")" && pwd)
files=$(git ls-files --cached --others --exclude-standard . | while read -r f; do case "$PWD/$f" in ("$self"/*) ;; (*) echo "$f" ;; esac; done)
for f in $(grep -E '(^|/)wrangler\.(json|jsonc|toml)$' <<<"$files" || true); do
  grep -nE '"?(account_id|database_id|preview_id)"?[[:space:]]*[:=]' "$f" && bad "$f holds an account or resource ID"
  grep -nE '"id"[[:space:]]*:|^[[:space:]]*id[[:space:]]*=' "$f" && bad "$f holds a resource ID"
done
for f in $files; do
  [ -f "$f" ] || continue
  grep -qE 'CLOUDFLARE_API_TOKEN[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9_-]{30,}' "$f" && bad "$f holds a Cloudflare token"
  case $f in *.md) ;; *) grep -nE 'wrangler +login' "$f" && bad "$f calls the machine-wide wrangler login" ;; esac
done
for f in .dev.vars .env; do git check-ignore -q "$f" || bad "$f isn't git-ignored"; done
want=$(worker_config | jq -r '.secrets[]' | sort)
have=$(grep -oE '^[A-Z_][A-Z0-9_]*=' .dev.vars.example 2>/dev/null | tr -d = | sort || true)
[ "$want" = "$have" ] || bad ".dev.vars.example lists [$(echo $have)], secrets.required lists [$(echo $want)]"
pin=$(jq -r '.devDependencies.wrangler // .dependencies.wrangler // "missing"' package.json)
[[ $pin =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || bad "wrangler isn't pinned to an exact version in package.json ($pin)"
[ $fail = 0 ] && echo "rules: pass" || exit 1
