#!/usr/bin/env bash
#MISE description="Deploy this repo's Worker on its own login (profile {{env.CF_PROFILE}}): logs in once if needed, lets wrangler create any missing D1, KV and R2, asks once for each secret not yet set (or takes it from the environment), deploys, prints the https://….workers.dev URL if it has one. Refuses a stray CLOUDFLARE_API_TOKEN"
#MISE depends=["cloudflare:setup"]
#MISE timeout="10m"
set -euo pipefail
. "$(dirname "$0")/.helpers.sh"
ensure_login
cfg=$(worker_config)
have=$(wrangler secret list --format json 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
secrets=$(mktemp); trap 'rm -f "$secrets" "$secrets.tmp"' EXIT
echo '{}' > "$secrets"
for s in $(jq -r '.secrets[]' <<<"$cfg"); do
  grep -qx "$s" <<<"$have" && continue
  if [ -n "${!s:-}" ]; then val=${!s}; else read -rsp "Value for the secret $s: " val </dev/tty; echo; fi
  jq --arg k "$s" --arg v "$val" '. + {($k): $v}' "$secrets" > "$secrets.tmp" && mv "$secrets.tmp" "$secrets"
  echo "secret $s: will be set"
done
out=$(wrangler deploy --secrets-file "$secrets" 2>&1 | tee /dev/stderr)
url=$(grep -oE 'https://[a-z0-9.-]+\.workers\.dev' <<<"$out" | head -1 || true)
mkdir -p .wrangler
if [ -n "$url" ]; then echo "$url" > .wrangler/cloudflare-url; echo "deployed: $url"
else rm -f .wrangler/cloudflare-url; echo "deployed, with no workers.dev URL (the Worker uses routes or a custom domain)"; fi
