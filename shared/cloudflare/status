#!/usr/bin/env bash
#MISE description="This repo's Cloudflare login (profile {{env.CF_PROFILE}}): logged in or not, its account and scopes; the Worker's https://….workers.dev URL and whether it answers; its D1, KV and R2. Also this machine's other wrangler logins (checksums, never contents) and stray tokens. --baseline saves the machine part; later runs say what changed"
#MISE timeout="2m"
#USAGE flag "--baseline" help="Save the machine part as the baseline (in .wrangler/, git-ignored) that later runs compare against"
set -euo pipefail
. "$(dirname "$0")/.helpers.sh"
home=$(wrangler_home)
baseline=.wrangler/cloudflare-baseline

snapshot() {
  echo "wrangler folder      ${home/#$HOME/~}"
  echo "default login        config/default.toml $(file_hash "$home/config/default.toml")"
  local profiles=none
  [ -d "$home/config" ] && profiles=$(cd "$home/config" && ls *.toml 2>/dev/null | grep -v '^default\.toml$' | sed 's/\.toml$//' | tr '\n' ' ')
  echo "other profiles       ${profiles:-none}"
  local bindings="$home/profiles/directory-bindings.json"
  if [ -f "$bindings" ]; then echo "folder bindings      $(jq -c . "$bindings" | sed "s#$HOME#~#g")"; else echo "folder bindings      none"; fi
  echo "this repo's profile  $CF_PROFILE: $([ -f "$(profile_file)" ] && echo "logged in" || echo "not logged in")"
  echo "CLOUDFLARE_API_TOKEN $([ -n "${CLOUDFLARE_API_TOKEN:-}" ] && echo "SET in this shell (would override every login)" || echo "not set")"
  local envs; envs=$(grep -ls '^CLOUDFLARE_API_TOKEN=.' .env .env.* 2>/dev/null | tr '\n' ' ' || true)
  echo ".env with a token    ${envs:-none}"
}

now=$(snapshot)
echo "$now"
if [ "${usage_baseline:-false}" = true ]; then
  mkdir -p .wrangler && echo "$now" > "$baseline"
  echo "saved as the baseline: $PWD/$baseline"
elif [ -f "$baseline" ]; then
  if diff <(grep -vE "^(this repo's profile|other profiles|folder bindings)" "$baseline") <(grep -vE "^(this repo's profile|other profiles|folder bindings)" <<<"$now") > /dev/null; then
    echo "machine logins: unchanged since the baseline"
  else
    echo "machine logins: CHANGED since the baseline:"; diff "$baseline" <(echo "$now") || true
  fi
fi

[ -f "$(profile_file)" ] || exit 0
[ -f node_modules/wrangler/bin/wrangler.js ] || { echo "run cloudflare:setup to see the account, the Worker and its resources"; exit 0; }
refuse_stray_tokens
wrangler auth activate "$CF_PROFILE" "$(pwd -P)" > /dev/null 2>&1
who=$(wrangler whoami --json 2>/dev/null </dev/null)
echo "account              $(jq -r '[.accounts[] | "\(.name) https://dash.cloudflare.com/\(.id)"] | join(", ")' <<<"$who")"
echo "scopes               $(jq -r '.tokenPermissions | join(" ")' <<<"$who")"
url=$(deployed_url)
if [ -n "$url" ]; then
  echo "worker               $url (HTTP $(curl -s -o /dev/null -w '%{http_code}' -m 15 "$url" || true))"
else
  echo "worker               not deployed from here"
fi
res=$(resources)
if [ -n "$res" ]; then sed 's/^/resource             /' <<<"$res"; else echo "resource             none"; fi
