#!/usr/bin/env bash
#MISE description="Remove this repo's Worker from Cloudflare, on its own login (profile {{env.CF_PROFILE}}). Its D1, KV and R2, and the data in them, are kept unless you add --data. Keeps the login; cloudflare:clean removes that"
#MISE depends=["cloudflare:setup"]
#MISE timeout="5m"
#USAGE flag "--data" help="Also delete every D1, KV and R2 in this repo's wrangler config, and all the data in them"
set -euo pipefail
. "$(dirname "$0")/.helpers.sh"
ensure_login
name=$(worker_config | jq -r .name)
if out=$(wrangler delete --force 2>&1 </dev/null); then echo "deleted the Worker $name"; else echo "$out" | tail -3; echo "(the Worker $name wasn't there)"; fi
rm -f .wrangler/cloudflare-url
res=$(resources)
if [ "${usage_data:-false}" != true ]; then
  [ -z "$res" ] || { echo "kept, with their data (add --data to delete them):"; sed 's/^/  /' <<<"$res"; }
  exit 0
fi
while read -r kind res id; do
  case $kind in
    d1) wrangler d1 delete "$res" -y </dev/null > /dev/null && echo "deleted D1 $res" ;;
    kv) wrangler kv namespace delete --namespace-id "$id" -y </dev/null > /dev/null && echo "deleted KV $res" ;;
    r2) empty_r2_bucket "$res" && wrangler r2 bucket delete "$res" </dev/null > /dev/null && echo "deleted R2 $res" ;;
  esac
done <<<"$res"
