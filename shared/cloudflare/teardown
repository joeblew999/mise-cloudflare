#!/usr/bin/env bash
#MISE description="Remove this repo's Worker from Cloudflare, and the D1, KV and R2 its deploy created (named after the Worker), on its own login (profile {{env.CF_PROFILE}}). Keeps the login; cloudflare:clean removes that"
#MISE depends=["cloudflare:setup"]
#MISE timeout="5m"
set -euo pipefail
. "$(dirname "$0")/.helpers.sh"
ensure_login
name=$(worker_config | jq -r .name)
if out=$(wrangler delete --force 2>&1 </dev/null); then echo "deleted the Worker $name"; else echo "$out" | tail -3; echo "(the Worker $name wasn't there)"; fi
resources | while read -r kind res id; do
  case $kind in
    d1) wrangler d1 delete "$res" -y </dev/null > /dev/null && echo "deleted D1 $res" ;;
    kv) wrangler kv namespace delete --namespace-id "$id" -y </dev/null > /dev/null && echo "deleted KV $res" ;;
    r2)
      # A bucket must be empty before it can go; wrangler can't list objects, Cloudflare's API can (with this login's token).
      acct=$(wrangler whoami --json </dev/null | jq -r 'if (.accounts | length) == 1 then .accounts[0].id else empty end')
      [ -n "$acct" ] || { echo "can't tell which account holds R2 $res: empty it in the dashboard, then run again"; exit 1; }
      token=$(wrangler auth token --json </dev/null | jq -r .token)
      curl -fsS -m 30 -H "Authorization: Bearer $token" "https://api.cloudflare.com/client/v4/accounts/$acct/r2/buckets/$res/objects" \
        | jq -r '.result[].key' | while read -r key; do wrangler r2 object delete "$res/$key" --remote </dev/null > /dev/null; done
      wrangler r2 bucket delete "$res" </dev/null > /dev/null && echo "deleted R2 $res" ;;
  esac
done
rm -f .wrangler/cloudflare-url
